# Variables de entorno del backend.
#
# Copiá este archivo a `backend/.env` para desarrollo local, y cargá las mismas
# claves en el panel del hosting para produccion (en Render: el servicio del
# backend > Environment > Environment Variables).
#
# Se llama `env.example` y no `.env.example` porque el .gitignore tiene
# `*.env.*`, que se lo comeria.

# ---------------------------------------------------------------------------
# OBLIGATORIAS — sin alguna de estas el server NO arranca (ver _validar_entorno)
# ---------------------------------------------------------------------------

# Cadena de conexion de MongoDB.
MONGO_URL=mongodb://localhost:27017

# Nombre de la base dentro de ese cluster.
DB_NAME=futbol-pro

# Secreto con el que se firman los tokens de sesion. Cualquier cadena larga y
# aleatoria. Si cambia, todas las sesiones abiertas se invalidan.
JWT_SECRET=cambiame-por-algo-largo-y-aleatorio

# Desde que origenes se aceptan pedidos, separados por coma.
#
# ES OBLIGATORIA A PROPOSITO. Su default era "*" y la API manda credenciales,
# asi que sin esto cualquier sitio podia hacerle pedidos autenticados en nombre
# de un usuario logueado. Mientras al grupo solo se entraba por invitacion a
# mano el daño era acotado; con el alta abierta, no.
#
# Van los origenes EXACTOS del front: con esquema, sin barra al final y sin
# ruta. "https://mi-app.onrender.com/" (con barra) no matchea.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# OPCIONALES
# ---------------------------------------------------------------------------

# Verificacion de email al registrarse. Por default esta APAGADA.
#
# Con la verificacion apagada, cualquiera puede registrarse con una direccion
# que no le pertenece, y por eso la vinculacion automatica del perfil de
# invitado queda deshabilitada: heredar un perfil de invitado es reclamar la
# identidad deportiva de otro, y sin verificar el email no hay nada que lo
# pruebe.
#
# OJO: ponerla en true SIN BREVO_API_KEY impide que el server arranque, y con
# razon — los mails no saldrian y nadie podria activar su cuenta.
EMAIL_VERIFICATION_ENABLED=false

# Envio de mails, via la API HTTP de Brevo (SMTP no sirve en Render free).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=App Futbol

# Base de los links que van en los mails (el de verificacion, por ejemplo).
# Sin ella se asume http://localhost:3000.
# FRONTEND_URL=https://mi-app.onrender.com

# Subida de fotos. Sin esto la app anda y el alta de perfil se completa igual:
# la foto es opcional, se guarda DESPUES del perfil y si falla solo se avisa.
# Sin la variable, /api/profile/photo y /api/players/{id}/photo contestan 503
# con un mensaje claro en vez de romper.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
